# Node config
node.name: "{{ inventory_hostname }}"
network.host: "{{ es_listen_addr }}"
network.bind_host: "{{ es_listen_addr }}"
network.publish_host: "{{ ansible_local.wireguard.vpn_ip }}"
transport.profiles.default.port: {{ es_node_port | mandatory }}
path.repo: "/var/backup"
http.max_initial_line_length: 16kB
bootstrap.memory_lock: {{ ex_memory_lock | to_json }}

# Security
xpack.security.enabled: {{ es_security_enabled | to_json }}
xpack.security.transport.ssl.enabled: {{ es_security_enabled | to_json }}
xpack.security.transport.ssl.client_authentication: required
xpack.security.transport.ssl.verification_mode: full
xpack.security.transport.ssl.key: "{{ es_transport_key_path | replace(es_transport_certs_path, "/usr/share/elasticsearch/config/certs") }}"
xpack.security.transport.ssl.certificate: "{{ es_transport_pem_path | replace(es_transport_certs_path, "/usr/share/elasticsearch/config/certs") }}"
xpack.security.transport.ssl.certificate_authorities: ["{{ es_transport_ca_pem_path | replace(es_transport_certs_path, "/usr/share/elasticsearch/config/certs") }}"]
xpack.security.http.ssl.enabled: false
xpack.security.authc.anonymous:
  username: healthcheck
  roles: healthcheck

# Cluster config
cluster.name: "{{ es_cluster_name | mandatory }}"
{% if (es_master_nodes|length) == 0 %}
discovery.type: single-node
{% else %}
discovery.seed_hosts:
{% for node in es_master_nodes %}
  - {{ node.addr | mandatory }}:{{ node.port | mandatory }} # {{ node.name | mandatory }}
{% endfor %}

# Tuning
cluster.routing.allocation.node_concurrent_recoveries: {{ es_node_concurrent_recoveries }}
{% if es_cluster_bootstrap %}

# Bootstrapping config
# WARNING: Should not be used after bootstrapping.
cluster.initial_master_nodes: {{ es_master_nodes | json_query("[].name") | to_yaml }}
{% if es_master_nodes[0].name == inventory_hostname %}
node.roles: [ master ]
{% endif %}
{% endif %}
{% endif %}
